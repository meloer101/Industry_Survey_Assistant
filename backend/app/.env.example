# ============================================================
# DeepSeek API Key (via LiteLLM)
# 获取地址：https://platform.deepseek.com/
# ============================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com

# ============================================================
# Tavily Search API Key
# 获取地址：https://app.tavily.com/
# ============================================================
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================================
# 应用 API Key（仅用于非 Clerk 的内部/开发兼容请求）
# 浏览器用户认证使用 Clerk Bearer token；API key 不提供用户身份。
# 本地开发可随意设置一个字符串；生产环境请使用强随机字符串：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 留空则跳过 API key 检查（仅限可信内网/本地 dev）
# ============================================================
APP_API_KEY=dev-local-key-change-in-production

# ============================================================
# Clerk 用户认证
# 获取地址：https://dashboard.clerk.com/ → API keys / JWT public key
# 本地无 Clerk 时可显式设置 CLERK_AUTH_ENABLED=false 使用 dev_user。
# ============================================================
CLERK_AUTH_ENABLED=true
CLERK_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
CLERK_DEV_USER_ID=dev_user

# ============================================================
# 允许访问后端的前端 Origin（逗号分隔）
# 开发环境默认值；生产环境改为实际部署域名
# ============================================================
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# LLM 模型配置（可选覆盖，默认值见 config.py）
# ============================================================
# WORKER_MODEL=deepseek/deepseek-v4-flash
# CRITIC_MODEL=deepseek/deepseek-v4-pro

# ============================================================
# 搜索迭代次数限制（可选，默认 3）
# ============================================================
# MAX_SEARCH_ITERATIONS=3

# ============================================================
# FRED API Key（可选，无 key 也可访问公开数据，有 key 速率限制更高）
# 获取地址：https://fred.stlouisfed.org/docs/api/api_key.html
# ============================================================
# FRED_API_KEY=your_fred_api_key_here

# ============================================================
# LiteLLM 全局重试次数（可选，默认 3）
# ============================================================
# LITELLM_NUM_RETRIES=3

# ============================================================
# Rate limit 每分钟最大请求数（可选，默认 60）
# ============================================================
# LLM_RPM_QUOTA=60

# ============================================================
# 日志配置
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=text

# ============================================================
# Session 持久化配置
# 默认使用本地 SQLite；生产可切换为 PostgreSQL session service URI
# ============================================================
# SESSION_DB_URL=sqlite:///app/.adk/session.db
# SESSION_TTL_DAYS=30
